# Leave ANTHROPIC_API_KEY empty to run in mock mode (keyword rules, no network calls).
ANTHROPIC_API_KEY=

# auto  = use Claude when ANTHROPIC_API_KEY is set, otherwise mock
# mock  = always use the offline keyword classifier
# claude = always call Claude (fails if no credentials)
TRIAGE_MODE=auto

# Optional model override. Default is claude-opus-5-5.
ANTHROPIC_MODEL=

PORT=3000
